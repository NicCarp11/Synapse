# NrCaches 3

// If there exist FIFO input buffers, the fwd requests and inv must be in different VCs to avoid deadlocks if an Inv overtakes a preceding Fwd_GetS 

Network {
          Ordered  fwd;   //FwdGetS, FwdGetM
          //Ordered inv;   // Inv
          //Unordered put_vc;   // PutAck
          Ordered  resp;  // Data, InvAck
          Ordered  req;   //GetS, GetM, PutM
          };

Cache {
    State I;
    Data cl;
    int[0..NrCaches] acksReceived = 0;
    int[0..NrCaches] acksExpected = 0;
} set[NrCaches] cache;

Directory {
    State I;
    Data cl;
    set[NrCaches] ID cache;
    ID owner;
} directory;

Message Request{};

Message Ack{};

Message Resp{
    Data cl;
};

Message RespAck{
    Data cl;
    int[0..NrCaches] acksExpected;
};

Architecture cache {

    Stable{I, S, M}

    // I ////////////////////////////////////////////////////////
    Process(I, load, State){
        msg = Request(GetS, ID, directory.ID);
        req.send(msg);

        await{
            when GetS_Ack:
                cl=GetS_Ack.cl;
                load;
                State = S;
                break;
        }
    }

    Process(I, store, State){
        msg = Request(GetM, ID, directory.ID);
        req.send(msg);
        acksReceived = 0;

        await{
            when GetM_Ack_D:
                cl=GetM_Ack_D.cl;
                store;
                State = M;
                break;

            when GetM_Ack_AD:
                cl=GetM_Ack_AD.cl;
                acksExpected = GetM_Ack_AD.acksExpected;

                if acksExpected == acksReceived{
                    store;
                    State = M;
                    break;
                }

                await{
                    when Inv_Ack:
                        acksReceived = acksReceived + 1;

                        if acksExpected == acksReceived{
                            store;
                            State = M;
                            break;
                        }
                    }

            when Inv_Ack:
                acksReceived = acksReceived + 1;

        }
    }

    Process(I, evict, State){
        msg = Request(PutI, ID, directory.ID);
        req.send(msg);

        await{
            when PutI_Ack:
                State = I;
                break;
        }
    }

//    Process(I, PutI_Ack, State){
//       State = I;
//    }

    // S ////////////////////////////////////////////////////////
    Process(S, load, S){
        load;
    }

    Process(S, store, State){
        msg = Request(GetM, ID, directory.ID);
        req.send(msg);
        acksReceived = 0;

        await{
            when GetM_Ack_D:
                store;
                State = M;
                break;

            when GetM_Ack_AD:
                acksExpected = GetM_Ack_AD.acksExpected;

                if acksExpected == acksReceived{
                    store;
                    State = M;
                    break;
                }

                await{
                    when Inv_Ack:
                        acksReceived = acksReceived + 1;

                        if acksExpected == acksReceived{
                            store;
                            State = M;
                            break;
                        }
                    }

            when Inv_Ack:
                acksReceived = acksReceived + 1;
        }
    }

    Process(S, evict, State){
        msg = Request(PutS, ID, directory.ID);
        req.send(msg);

        await{
            when PutS_Ack:
                State = I;
                break;
        }
    }

    Process(S, Inv, I){
        msg = Resp(Inv_Ack, ID, Inv.src, cl);
        resp.send(msg);
    }


    // M ////////////////////////////////////////////////////////
    Process(M, load){
        load;
    }

    Process(M, store, M){
        store;
    }

    Process(M, Fwd_GetM, I){
        msg = Resp(GetM_Ack_D, ID, Fwd_GetM.src, cl);
        resp.send(msg);
    }

    Process(M, Fwd_GetS, S){
        msg = Resp(GetS_Ack, ID, Fwd_GetS.src, cl);
        resp.send(msg);
        msg = Resp(WB, ID, directory.ID, cl);
        resp.send(msg);
    }

    Process(M, evict, State){
        msg = Resp(PutM, ID, directory.ID, cl);
        req.send(msg);

        await{
            when PutM_Ack:
                State = I;
                break;
        }
    }

}

Architecture directory {

    Stable{I, S, M}

    // I ////////////////////////////////////////////////////////
    Process(I, GetS, S){
       cache.add(GetS.src);
       msg = Resp(GetS_Ack, ID, GetS.src, cl);
       resp.send(msg);
    }

    Process(I, GetM, M){
        msg = Resp(GetM_Ack_D, ID, GetM.src, cl);
        resp.send(msg);
        owner = GetM.src;
    }

//    Process(I, PutI){
//       msg = Ack(PutI_Ack, ID, PutI.src);
//       resp.send(msg);
//       cache.del(PutI.src);
//
//       if cache.count() == 0{
//            State=I;
//            break;
//       }
//    }

    Process(I, PutS){
       msg = Ack(PutI_Ack, ID, PutS.src);
       resp.send(msg);
       cache.del(PutS.src);

       if cache.count() == 0{
            State=I;
            break;
       }
    }

    Process(I, PutM){
       msg = Ack(PutI_Ack, ID, PutM.src);
       resp.send(msg);
       cache.del(PutM.src);

       if cache.count() == 0{
            State=I;
            break;
       }
    }

    // S ////////////////////////////////////////////////////////
    Process(S, GetS){
       cache.add(GetS.src);
       msg = Resp(GetS_Ack, ID, GetS.src, cl);
       resp.send(msg);
    }

    Process(S, GetM){
       if cache.contains(GetM.src){
           cache.del(GetM.src);
           if cache.count() == 0{
                msg = Resp(GetM_Ack_D, ID, GetM.src, cl);
                resp.send(msg);
                State=M;
           } else{
               msg = RespAck(GetM_Ack_AD, ID, GetM.src, cl, cache.count());
               resp.send(msg);
               msg = Ack(Inv, GetM.src, GetM.src);
               //inv.mcast(msg, cache);
               fwd.mcast(msg, cache);
               State=M;
           }
           owner = GetM.src;
           cache.clear();
       } else {
           msg = RespAck(GetM_Ack_AD, ID, GetM.src, cl, cache.count());
           resp.send(msg);
           State=M;
           msg = Ack(Inv, GetM.src, GetM.src);
           //inv.mcast(msg, cache);
           fwd.mcast(msg, cache);
           owner = GetM.src;
           cache.clear();
       }
    }

    Process(S, PutS){
       if cache.contains(PutS.src){
            msg = Ack(PutS_Ack, ID, PutS.src);
            resp.send(msg);
            cache.del(PutS.src);        
       } else {
            msg = Ack(PutI_Ack, ID, PutS.src);
            resp.send(msg);        
       }

       if cache.count() == 0{
            State=I;
            break;
       }
    }

    Process(S, PutM){
       if cache.contains(PutM.src){
            msg = Ack(PutS_Ack, ID, PutM.src);
            resp.send(msg);
            cache.del(PutM.src);
       } else {
            msg = Ack(PutI_Ack, ID, PutI.src);
            resp.send(msg);        
       }

       if cache.count() == 0{
            State=I;
            break;
       }
    }

//    Process(S, PutI){
//       msg = Ack(PutI_Ack, ID, PutI.src);
//       resp.send(msg);
//       cache.del(PutI.src);
//
//       if cache.count() == 0{
//            State=I;
//            break;
//       }
//    }

    // M ////////////////////////////////////////////////////////
    Process(M, GetS){
       msg = Request(Fwd_GetS, GetS.src, owner);
       fwd.send(msg);
       cache.add(GetS.src);
       cache.add(owner);

       await{
            when WB:
                if WB.src == owner{
                    cl = WB.cl;
                    State=S;
                    break;
                }
       }

    }

    Process(M, GetM){
       msg = Request(Fwd_GetM, GetM.src, owner);
       fwd.send(msg);
       owner = GetM.src;
    }

    Process(M, PutM, State){
       if owner == PutM.src{
            msg = Ack(PutM_Ack, ID, PutM.src);
            resp.send(msg);
            cl = PutM.cl;
            State=I;
       }
       else{
            msg = Ack(PutI_Ack, ID, PutM.src);
            resp.send(msg);
       }
    }

}