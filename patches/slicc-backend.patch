+++ b/Backend/SLICC/TempSLICC/machines_v20/mandatory_cpu_in_port.sm
@@ -0,0 +1,45 @@
+in_port(mandatory_in, RubyRequest, mandatoryQueue) {
+  if (mandatory_in.isReady(clockEdge())) {
+    peek(mandatory_in, RubyRequest, block_on="LineAddress") {
+      Addr LineAddress := in_msg.LineAddress;
+      Entry entry := getEntry(LineAddress);
+      DPRINTF(RubySlicc, "mandatory_in: %s %s (addr: %#x)\n", in_msg.Type, getState(TBEs[LineAddress], entry, LineAddress), LineAddress);
+      if (is_invalid(entry) && cache_instruction.cacheAvail(LineAddress) == false$4$) {
+      Addr victim := cache_instruction.cacheProbe(in_msg.LineAddress);
+        DPRINTF(RubySlicc, "Evicting %#x (%s) for %#x\n", victim, getState(TBEs[victim], getEntry(victim), victim), LineAddress);
+        Addr LineAddress := victim;
+        TBE tbe := TBEs[LineAddress];
+        Entry entry := getEntry(LineAddress);
+        State st := getState(tbe, entry, LineAddress);
+        $0$
+      } else if (is_invalid(entry) &&
+          cache.cacheAvail(LineAddress) == false$5$) {
+        Addr victim := cache.cacheProbe(in_msg.LineAddress);
+        DPRINTF(RubySlicc, "Evicting %#x (%s) for %#x\n", victim, getState(TBEs[victim], getEntry(victim), victim), LineAddress);
+        Addr LineAddress := victim;
+        TBE tbe := TBEs[LineAddress];
+        Entry entry := getEntry(LineAddress);
+        State st := getState(tbe, entry, LineAddress);
+        $0$
+      } else {
+        TBE tbe := TBEs[LineAddress];
+        Entry entry := getEntry(LineAddress);
+        State st := getState(tbe, entry, LineAddress);
+        if (in_msg.Type == RubyRequestType:LD || in_msg.Type == RubyRequestType:LD_NT ||
+            in_msg.Type == RubyRequestType:LD_ACQ) {
+        $1$
+
+        } else if (in_msg.Type == RubyRequestType:IFETCH) {
+        $2$
+        } else if (in_msg.Type == RubyRequestType:ST || in_msg.Type == RubyRequestType:ST_NT ||
+                   in_msg.Type == RubyRequestType:ST_REL || in_msg.Type == RubyRequestType:ATOMIC ||
+                   in_msg.Type == RubyRequestType:ATOMIC_RETURN ||
+                   in_msg.Type == RubyRequestType:ATOMIC_NO_RETURN) {
+        $3$
+        } else {
+          error("Unexpected message type from processor");
+        }
+      }
+    }
+  }
+}
